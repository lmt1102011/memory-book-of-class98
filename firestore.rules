rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isManagerWrite() {
      return request.resource.data.managerKey == 'class98-manager-2026';
    }

    match /students98/{nameKey} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8';
      allow update: if (
        request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
      ) || isManagerWrite();
      allow delete: if false;
    }

    match /memories98/{memoryId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.imageUrl is string;
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['reactions', 'updatedAt'])
        && request.resource.data.reactions is int
        && request.resource.data.reactions >= resource.data.reactions
        && request.resource.data.reactions <= resource.data.reactions + 1;
      allow delete: if false;
    }

    match /guestbook98/{entryId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 160;
      allow update, delete: if false;
    }

    match /secretMailbox98/{letterId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.className == '9/8'
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 450
        && !('name' in request.resource.data)
        && !('uid' in request.resource.data);
      allow update, delete: if false;
    }

    match /secretMailboxPrivate98/{letterId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.name is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 450;
      allow update: if isManagerWrite();
      allow delete: if false;
    }
  }
}
