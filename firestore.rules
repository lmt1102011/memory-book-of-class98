rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isManagerWrite() {
      return request.resource.data.managerKey == 'class98-manager-2026'
        || request.resource.data.managerKey == 'lmt1102011';
    }

    function isManagerMarkedResource() {
      return resource.data.managerKey == 'class98-manager-2026'
        || resource.data.managerKey == 'lmt1102011';
    }

    function ownsResource() {
      return request.auth != null
        && (
          resource.data.uid == request.auth.uid
          || (
            resource.data.nameKey is string
            && request.auth.token.email == resource.data.nameKey + '@memorybook-of-class98.firebaseapp.com'
          )
        );
    }

    function oldLikedBy() {
      return resource.data.keys().hasAny(['likedBy']) && resource.data.likedBy is list
        ? resource.data.likedBy
        : [];
    }

    function validOneLikeUpdate() {
      return request.auth != null
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['reactions', 'likedBy', 'updatedAt'])
        && request.resource.data.reactions is int
        && request.resource.data.reactions == resource.data.reactions + 1
        && request.resource.data.likedBy is list
        && !(request.auth.uid in oldLikedBy())
        && request.auth.uid in request.resource.data.likedBy
        && request.resource.data.likedBy.size() == oldLikedBy().size() + 1
        && request.resource.data.likedBy.hasAll(oldLikedBy());
    }

    match /students98/{nameKey} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8';
      allow update: if (
        request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
      ) || isManagerWrite();
      allow delete: if false;
    }

    match /memories98/{memoryId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.imageUrl is string;
      allow update: if validOneLikeUpdate() || isManagerWrite();
      allow delete: if ownsResource() || isManagerMarkedResource();
    }

    match /memoryComments98/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.memoryId is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 240;
      allow update: if false;
      allow delete: if ownsResource();
    }

    match /guestbook98/{entryId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 160;
      allow update: if false;
      allow delete: if ownsResource();
    }

    match /secretMailbox98/{letterId} {
      allow read, create, update, delete: if false;
    }

    match /rememberNotes98/{noteId} {
      allow read: if request.auth != null
        && request.auth.token.email == resource.data.toNameKey + '@memorybook-of-class98.firebaseapp.com';
      allow create: if request.auth != null
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.fromName is string
        && request.resource.data.fromNameKey is string
        && request.resource.data.toName is string
        && request.resource.data.toNameKey is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 420
        && request.resource.data.anonymous is bool
        && request.resource.data.kind == 'remember-note';
      allow update: if false;
      allow delete: if request.auth != null
        && (
          resource.data.fromUid == request.auth.uid
          || request.auth.token.email == resource.data.toNameKey + '@memorybook-of-class98.firebaseapp.com'
        );
    }

    match /secretMailboxPrivate98/{diaryId} {
      // The main app only queries the signed-in student's own uid.
      // The static manager page also reads this collection to show the writer name.
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.name is string
        && request.resource.data.nameKey is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1200
        && request.resource.data.kind == 'secret-diary';
      allow update: if isManagerWrite();
      allow delete: if ownsResource();
    }
  }
}
