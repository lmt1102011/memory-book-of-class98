rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isManagerWrite() {
      return request.resource.data.managerKey == 'class98-manager-2026'
        || request.resource.data.managerKey == 'lmt1102011';
    }

    function isManagerMarkedResource() {
      return resource.data.managerKey == 'class98-manager-2026'
        || resource.data.managerKey == 'lmt1102011';
    }

    function isManagerAuth() {
      return request.auth != null
        && request.auth.token.email == 'le-minh-tri@memorybook-of-class98.firebaseapp.com';
    }

    function ownsResource() {
      return request.auth != null
        && (
          resource.data.uid == request.auth.uid
          || (
            resource.data.nameKey is string
            && authMatchesStudentNameKey(resource.data.nameKey)
          )
        );
    }

    function oldLikedBy() {
      return resource.data.keys().hasAny(['likedBy']) && resource.data.likedBy is list
        ? resource.data.likedBy
        : [];
    }

    function oldHeartedBy() {
      return resource.data.keys().hasAny(['heartedBy']) && resource.data.heartedBy is list
        ? resource.data.heartedBy
        : [];
    }

    function newCommentHahaBy() {
      return request.resource.data.keys().hasAny(['reactionHahaBy']) && request.resource.data.reactionHahaBy is list
        ? request.resource.data.reactionHahaBy
        : [];
    }

    function newCommentLoveBy() {
      return request.resource.data.keys().hasAny(['reactionLoveBy']) && request.resource.data.reactionLoveBy is list
        ? request.resource.data.reactionLoveBy
        : [];
    }

    function newCommentMissBy() {
      return request.resource.data.keys().hasAny(['reactionMissBy']) && request.resource.data.reactionMissBy is list
        ? request.resource.data.reactionMissBy
        : [];
    }

    function newCommentWowBy() {
      return request.resource.data.keys().hasAny(['reactionWowBy']) && request.resource.data.reactionWowBy is list
        ? request.resource.data.reactionWowBy
        : [];
    }

    function newCommentAngryBy() {
      return request.resource.data.keys().hasAny(['reactionAngryBy']) && request.resource.data.reactionAngryBy is list
        ? request.resource.data.reactionAngryBy
        : [];
    }

    function emptyCommentReactionsOnCreate() {
      return (!request.resource.data.keys().hasAny(['reactionHahaBy']) || (request.resource.data.reactionHahaBy is list && request.resource.data.reactionHahaBy.size() == 0))
        && (!request.resource.data.keys().hasAny(['reactionLoveBy']) || (request.resource.data.reactionLoveBy is list && request.resource.data.reactionLoveBy.size() == 0))
        && (!request.resource.data.keys().hasAny(['reactionMissBy']) || (request.resource.data.reactionMissBy is list && request.resource.data.reactionMissBy.size() == 0))
        && (!request.resource.data.keys().hasAny(['reactionWowBy']) || (request.resource.data.reactionWowBy is list && request.resource.data.reactionWowBy.size() == 0))
        && (!request.resource.data.keys().hasAny(['reactionAngryBy']) || (request.resource.data.reactionAngryBy is list && request.resource.data.reactionAngryBy.size() == 0));
    }

    function newCommentReactionUserCount() {
      return (request.auth.uid in newCommentHahaBy() ? 1 : 0)
        + (request.auth.uid in newCommentLoveBy() ? 1 : 0)
        + (request.auth.uid in newCommentMissBy() ? 1 : 0)
        + (request.auth.uid in newCommentWowBy() ? 1 : 0)
        + (request.auth.uid in newCommentAngryBy() ? 1 : 0);
    }

    function validCommentReactionUpdate() {
      return request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reactionHahaBy',
          'reactionLoveBy',
          'reactionMissBy',
          'reactionWowBy',
          'reactionAngryBy',
          'updatedAt'
        ])
        && request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'reactionHahaBy',
          'reactionLoveBy',
          'reactionMissBy',
          'reactionWowBy',
          'reactionAngryBy'
        ])
        && newCommentReactionUserCount() == 1
        && request.resource.data.reactionHahaBy is list
        && request.resource.data.reactionLoveBy is list
        && request.resource.data.reactionMissBy is list
        && request.resource.data.reactionWowBy is list
        && request.resource.data.reactionAngryBy is list
        && request.resource.data.reactionHahaBy.size() <= 1000
        && request.resource.data.reactionLoveBy.size() <= 1000
        && request.resource.data.reactionMissBy.size() <= 1000
        && request.resource.data.reactionWowBy.size() <= 1000
        && request.resource.data.reactionAngryBy.size() <= 1000;
    }

    function validManagerCommentRepair() {
      return isManagerWrite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reactionHahaBy',
          'reactionLoveBy',
          'reactionMissBy',
          'reactionWowBy',
          'reactionAngryBy',
          'managerKey',
          'managerUpdatedAt'
        ])
        && request.resource.data.reactionHahaBy is list
        && request.resource.data.reactionLoveBy is list
        && request.resource.data.reactionMissBy is list
        && request.resource.data.reactionWowBy is list
        && request.resource.data.reactionAngryBy is list
        && request.resource.data.reactionHahaBy.size() <= 1000
        && request.resource.data.reactionLoveBy.size() <= 1000
        && request.resource.data.reactionMissBy.size() <= 1000
        && request.resource.data.reactionWowBy.size() <= 1000
        && request.resource.data.reactionAngryBy.size() <= 1000;
    }

    function validClassSignatureNameKey(nameKey) {
      return nameKey is string
        && nameKey.matches('[a-z0-9-]{1,80}');
    }

    function authEmailBelongsToStudentKey(nameKey) {
      return request.auth != null
        && request.auth.token.email is string
        && request.auth.token.email.matches(
          '^' + nameKey + '(\\.re\\.[a-z0-9]+\\.[a-z0-9]+)?@memorybook-of-class98\\.firebaseapp\\.com$'
        );
    }

    function openStudentDocExists(nameKey) {
      return exists(/databases/$(database)/documents/students98/$(nameKey))
        && get(/databases/$(database)/documents/students98/$(nameKey)).data.className == '9/8'
        && get(/databases/$(database)/documents/students98/$(nameKey)).data.deleted != true
        && get(/databases/$(database)/documents/students98/$(nameKey)).data.disabled != true;
    }

    function openStudentDocMissingOrOpen(nameKey) {
      return !exists(/databases/$(database)/documents/students98/$(nameKey))
        || openStudentDocExists(nameKey);
    }

    function canWriteClassSignatureFor(nameKey) {
      return request.auth != null
        && validClassSignatureNameKey(nameKey)
        && openStudentDocMissingOrOpen(nameKey)
        && (
          authEmailBelongsToStudentKey(nameKey)
          || (
            openStudentDocExists(nameKey)
            && (
              get(/databases/$(database)/documents/students98/$(nameKey)).data.uid == request.auth.uid
              || get(/databases/$(database)/documents/students98/$(nameKey)).data.authEmail == request.auth.token.email
            )
          )
        );
    }

    function classSignatureFields() {
      return [
        'uid',
        'name',
        'nameKey',
        'className',
        'imageDataUrl',
        'createdAt',
        'updatedAt'
      ];
    }

    function validClassSignaturePayload(signatureId) {
      return request.auth != null
        && signatureId == request.resource.data.nameKey
        && request.resource.data.uid is string
        && request.resource.data.uid.size() <= 140
        && request.resource.data.className == '9/8'
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 80
        && validClassSignatureNameKey(request.resource.data.nameKey)
        && request.resource.data.imageDataUrl is string
        && request.resource.data.imageDataUrl.matches('data:image/(png|webp|jpeg|jpg);base64,.*')
        && request.resource.data.imageDataUrl.size() <= 750000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && canWriteClassSignatureFor(signatureId);
    }

    function validClassSignatureCreate(signatureId) {
      return request.resource.data.keys().hasOnly(classSignatureFields())
        && validClassSignaturePayload(signatureId);
    }

    function validClassSignatureUpdate(signatureId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(classSignatureFields())
        && validClassSignaturePayload(signatureId);
    }

    function isPublicMemoryResource() {
      return !resource.data.keys().hasAny(['visibility'])
        || resource.data.visibility == 'public';
    }

    function canAccessPrivateMemoryResource() {
      return request.auth != null
        && (
          resource.data.uid == request.auth.uid
          || (
            resource.data.visibleToUids is list
            && request.auth.uid in resource.data.visibleToUids
          )
        );
    }

    function validMemoryBaseCreate() {
      return request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.imageUrl is string
        && request.resource.data.caption is string
        && request.resource.data.hashtags is list;
    }

    function ownsVideoChunkParent(memoryId) {
      return (
          request.resource.data.memoryCollection == 'memories98'
          && exists(/databases/$(database)/documents/memories98/$(memoryId))
          && get(/databases/$(database)/documents/memories98/$(memoryId)).data.uid == request.auth.uid
        )
        || (
          request.resource.data.memoryCollection == 'privateMemories98'
          && exists(/databases/$(database)/documents/privateMemories98/$(memoryId))
          && get(/databases/$(database)/documents/privateMemories98/$(memoryId)).data.uid == request.auth.uid
        );
    }

    function validOneLikeUpdate() {
      return request.auth != null
        && (isPublicMemoryResource() || canAccessPrivateMemoryResource())
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['reactions', 'likedBy', 'updatedAt'])
        && request.resource.data.reactions is int
        && request.resource.data.reactions == resource.data.reactions + 1
        && request.resource.data.likedBy is list
        && !(request.auth.uid in oldLikedBy())
        && request.auth.uid in request.resource.data.likedBy
        && request.resource.data.likedBy.size() == oldLikedBy().size() + 1
        && request.resource.data.likedBy.hasAll(oldLikedBy());
    }

    function isRememberReceiver() {
      return request.auth != null
        && resource.data.toNameKey is string
        && request.auth.token.email == resource.data.toNameKey + '@memorybook-of-class98.firebaseapp.com';
    }

    function validRememberViewedUpdate() {
      return isRememberReceiver()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedAt', 'updatedAt']);
    }

    function validRememberHeartUpdate() {
      return isRememberReceiver()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['heartedBy', 'updatedAt'])
        && request.resource.data.heartedBy is list
        && !(request.auth.uid in oldHeartedBy())
        && request.auth.uid in request.resource.data.heartedBy
        && request.resource.data.heartedBy.size() == oldHeartedBy().size() + 1
        && request.resource.data.heartedBy.hasAll(oldHeartedBy());
    }

    function validRememberReactionUpdate() {
      return isRememberReceiver()
        && resource.data.fromUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reactionId',
          'reactionLabel',
          'reactedAt',
          'reactedBy',
          'updatedAt'
        ])
        && request.resource.data.reactionId in ['miss-you', 'thank-you', 'regret', 'good-luck']
        && request.resource.data.reactionLabel in ['Nhớ cậu', 'Cảm ơn', 'Tiếc nuối', 'Chúc may mắn']
        && request.resource.data.reactedBy == request.auth.uid
        && request.resource.data.reactedAt is timestamp;
    }

    function validVoteCategoryCreate() {
      return request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 180
        && request.resource.data.tone in ['pink', 'blue', 'cream', 'chalk']
        && request.resource.data.icon is string
        && request.resource.data.hidden == false;
    }

    function validVoteCategoryHide() {
      return request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'hiddenAt', 'updatedAt'])
        && request.resource.data.hidden == true;
    }

    function validVoteWrite(voteId) {
      return request.auth != null
        && voteId == request.auth.uid
        && request.resource.data.voterUid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.targetUid is string
        && request.resource.data.targetName is string
        && request.resource.data.targetNameKey is string;
    }

    function validTimeCapsuleCreate() {
      return request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.name is string
        && request.resource.data.nameKey is string
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 900;
    }

    function validSiteSettingWrite(settingId) {
      return isManagerWrite()
        && (
          (
            settingId == 'memoryRecap'
            && request.resource.data.enabled is bool
          )
          || (
            settingId == 'classLetters'
            && request.resource.data.enabled is bool
          )
          || (
            settingId == 'writingPrompts'
            && request.resource.data.enabled is bool
          )
          || (
            settingId == 'cinematicSlideshow'
            && request.resource.data.enabled is bool
            && request.resource.data.mood in ['cinematic', 'scrapbook', 'photobooth']
          )
          || (
            settingId == 'timeCapsule'
            && request.resource.data.unlockAt is string
          )
        );
    }

    function validManagerReminderCreate() {
      return isManagerWrite()
        && request.resource.data.keys().hasOnly([
          'title',
          'body',
          'kind',
          'targetType',
          'targetUid',
          'targetNameKey',
          'targetName',
          'managerKey',
          'createdBy',
          'createdAt'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 90
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 420
        && request.resource.data.kind == 'manager-reminder'
        && request.resource.data.targetType in ['all', 'student']
        && request.resource.data.targetUid is string
        && request.resource.data.targetUid.size() <= 140
        && request.resource.data.targetNameKey is string
        && request.resource.data.targetNameKey.size() <= 80
        && request.resource.data.targetName is string
        && request.resource.data.targetName.size() <= 80
        && (
          (
            request.resource.data.targetType == 'all'
            && request.resource.data.targetUid == ''
            && request.resource.data.targetNameKey == ''
            && request.resource.data.targetName == ''
          )
          || (
            request.resource.data.targetType == 'student'
            && request.resource.data.targetNameKey.matches('[a-z0-9-]{1,80}')
            && request.resource.data.targetName.size() > 0
          )
        )
        && request.resource.data.createdBy is string
        && request.resource.data.createdBy.size() <= 80
        && request.resource.data.createdAt is timestamp;
    }

    function validStudentCreate(nameKey) {
      return request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nameKey == nameKey
        && request.resource.data.className == '9/8'
        && validStudentAuthEmail()
        && (
          !request.resource.data.keys().hasAny(['disabled'])
          || request.resource.data.disabled == false
        )
        && (
          !request.resource.data.keys().hasAny(['deleted'])
          || request.resource.data.deleted == false
        );
    }

    function authMatchesStudentNameKey(nameKey) {
      return request.auth != null
        && request.auth.token.email is string
        && (
          request.auth.token.email == nameKey + '@memorybook-of-class98.firebaseapp.com'
          || (
            validClassSignatureNameKey(nameKey)
            && request.auth.token.email.matches(
              '^' + nameKey + '(\\.re\\.[a-z0-9]+\\.[a-z0-9]+)?@memorybook-of-class98\\.firebaseapp\\.com$'
            )
          )
        );
    }

    function validStudentAuthEmail() {
      return !request.resource.data.keys().hasAny(['authEmail'])
        || (
          request.resource.data.authEmail is string
          && request.resource.data.authEmail == request.auth.token.email
        );
    }

    function studentIsDisabled() {
      return resource.data.keys().hasAny(['disabled'])
        && resource.data.disabled == true;
    }

    function studentIsDeleted() {
      return resource.data.keys().hasAny(['deleted'])
        && resource.data.deleted == true;
    }

    function validStudentNicknameOwnership(nameKey) {
      return !request.resource.data.keys().hasAny(['nicknameKey'])
        || request.resource.data.nicknameKey == ''
        || (
          request.resource.data.nicknameKey is string
          && existsAfter(/databases/$(database)/documents/nicknameClaims98/$(request.resource.data.nicknameKey))
          && getAfter(/databases/$(database)/documents/nicknameClaims98/$(request.resource.data.nicknameKey)).data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/nicknameClaims98/$(request.resource.data.nicknameKey)).data.nameKey == nameKey
        );
    }

    function validStudentOwnerUpdate(nameKey) {
      return request.auth != null
        && resource.data.uid == request.auth.uid
        && !studentIsDisabled()
        && !studentIsDeleted()
        && request.resource.data.uid == resource.data.uid
        && validStudentAuthEmail()
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['nickname', 'nicknameKey'])
          || validStudentNicknameOwnership(nameKey)
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'authEmail',
          'avatarDataUrl',
          'nickname',
          'nicknameKey',
          'quote',
          'classMessage',
          'personalityTags',
          'profileUpdatedAt',
          'lastLoginAt',
          'onlineAt',
          'lastSeenAt'
        ]);
    }

    function validStudentDeletedRestore(nameKey) {
      return request.auth != null
        && (
          resource.data.uid == request.auth.uid
          || authMatchesStudentNameKey(nameKey)
          || (
            request.resource.data.keys().hasAny(['authEmail'])
            && request.resource.data.authEmail == request.auth.token.email
          )
        )
        && !studentIsDisabled()
        && studentIsDeleted()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nameKey == nameKey
        && request.resource.data.className == '9/8'
        && validStudentAuthEmail()
        && request.resource.data.disabled == false
        && request.resource.data.deleted == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid',
          'name',
          'nameKey',
          'authEmail',
          'className',
          'disabled',
          'deleted',
          'createdAt',
          'repairedAt',
          'lastLoginAt',
          'onlineAt',
          'lastSeenAt'
        ]);
    }

    function validStudentSelfRepair(nameKey) {
      return request.auth != null
        && (
          resource.data.uid == request.auth.uid
          || authMatchesStudentNameKey(nameKey)
        )
        && !studentIsDisabled()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nameKey == nameKey
        && request.resource.data.className == '9/8'
        && validStudentAuthEmail()
        && request.resource.data.disabled == false
        && request.resource.data.deleted == false
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'uid',
          'name',
          'nameKey',
          'authEmail',
          'className',
          'disabled',
          'deleted',
          'createdAt',
          'repairedAt',
          'lastLoginAt',
          'onlineAt',
          'lastSeenAt'
        ]);
    }

    function validNicknameClaimBase(nicknameKey) {
      return request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nameKey is string
        && request.resource.data.nickname is string
        && request.resource.data.nicknameKey == nicknameKey
        && request.resource.data.className == '9/8';
    }

    function validNicknameClaimCreate(nicknameKey) {
      return validNicknameClaimBase(nicknameKey);
    }

    function validNicknameClaimUpdate(nicknameKey) {
      return validNicknameClaimBase(nicknameKey)
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid;
    }

    match /students98/{nameKey} {
      allow read: if true;
      allow create: if validStudentCreate(nameKey);
      allow update: if validStudentOwnerUpdate(nameKey)
        || validStudentDeletedRestore(nameKey)
        || validStudentSelfRepair(nameKey)
        || isManagerWrite();
      allow delete: if isManagerMarkedResource();
    }

    match /nicknameClaims98/{nicknameKey} {
      allow read: if request.auth != null;
      allow create: if validNicknameClaimCreate(nicknameKey);
      allow update: if validNicknameClaimUpdate(nicknameKey) || isManagerWrite();
      allow delete: if (
          request.auth != null
          && resource.data.uid == request.auth.uid
        )
        || isManagerMarkedResource();
    }

    match /memories98/{memoryId} {
      allow read: if true;
      allow create: if validMemoryBaseCreate()
        && (
          !request.resource.data.keys().hasAny(['visibility'])
          || request.resource.data.visibility == 'public'
        );
      allow update: if validOneLikeUpdate() || isManagerWrite();
      allow delete: if ownsResource() || isManagerMarkedResource();
    }

    match /privateMemories98/{memoryId} {
      allow read: if canAccessPrivateMemoryResource() || isManagerAuth();
      allow create: if validMemoryBaseCreate()
        && request.resource.data.visibility in ['private', 'tagged']
        && (
          request.resource.data.visibility == 'private'
          || (
            request.resource.data.visibleToUids is list
            && request.resource.data.visibleToUids.size() > 0
            && request.resource.data.visibleToUids.size() <= 30
          )
        );
      allow update: if validOneLikeUpdate() || isManagerWrite();
      allow delete: if ownsResource() || isManagerMarkedResource();
    }

    match /memoryVideoChunks98/{memoryId}/chunks/{chunkId} {
      allow read: if isManagerAuth()
        || (
          request.auth != null
          && (
            resource.data.visibility == 'public'
            || resource.data.uid == request.auth.uid
            || (
              resource.data.visibleToUids is list
              && request.auth.uid in resource.data.visibleToUids
            )
          )
        );
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.memoryId == memoryId
        && request.resource.data.memoryCollection in ['memories98', 'privateMemories98']
        && ownsVideoChunkParent(memoryId)
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 750000
        && request.resource.data.index is int
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 24
        && request.resource.data.visibility in ['public', 'private', 'tagged']
        && (
          request.resource.data.visibility != 'tagged'
          || (
            request.resource.data.visibleToUids is list
            && request.resource.data.visibleToUids.size() > 0
            && request.resource.data.visibleToUids.size() <= 30
          )
        );
      allow update: if isManagerWrite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerKey', 'managerDeletedAt']);
      allow delete: if ownsResource() || isManagerMarkedResource();
    }

    match /memoryComments98/{commentId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.memoryId is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 240
        && emptyCommentReactionsOnCreate();
      allow update: if validCommentReactionUpdate() || validManagerCommentRepair();
      allow delete: if ownsResource();
    }

    match /memoryDownloadLogs98/{logId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.memoryId is string
        && request.resource.data.memoryCollection in ['memories98', 'privateMemories98']
        && request.resource.data.memoryMediaType in ['image', 'video']
        && request.resource.data.name is string
        && request.resource.data.nameKey is string
        && request.resource.data.memoryOwnerName is string;
      allow update, delete: if false;
    }

    match /siteSettings98/{settingId} {
      allow read: if true;
      allow create, update: if validSiteSettingWrite(settingId);
      allow delete: if false;
    }

    match /managerReminders98/{reminderId} {
      allow read: if request.auth != null;
      allow create: if validManagerReminderCreate();
      allow update, delete: if false;
    }

    match /guestbook98/{entryId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 160;
      allow update: if isManagerWrite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerKey', 'managerDeletedAt']);
      allow delete: if ownsResource() || isManagerMarkedResource();
    }

    match /timeCapsules98/{entryId} {
      allow read: if true;
      allow create: if validTimeCapsuleCreate();
      allow update: if isManagerWrite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerKey', 'managerDeletedAt']);
      allow delete: if ownsResource() || isManagerMarkedResource();
    }

    match /classSignatures98/{signatureId} {
      allow read: if true;
      allow create: if validClassSignatureCreate(signatureId);
      allow update: if validClassSignatureUpdate(signatureId);
      allow delete: if ownsResource() || isManagerMarkedResource();
    }

    match /secretMailbox98/{letterId} {
      allow read, create, update, delete: if false;
    }

    match /rememberNotes98/{noteId} {
      allow read: if true;
      allow create: if request.resource.data.className == '9/8'
        && request.resource.data.fromName is string
        && request.resource.data.fromNameKey is string
        && request.resource.data.toName is string
        && request.resource.data.toNameKey is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 420
        && request.resource.data.anonymous is bool
        && request.resource.data.kind == 'remember-note';
      allow update: if validRememberViewedUpdate() || validRememberHeartUpdate() || validRememberReactionUpdate();
      allow delete: if true;
    }

    match /voteCategories98/{categoryId} {
      allow read: if resource.data.hidden == false;
      allow create: if validVoteCategoryCreate();
      allow update: if validVoteCategoryHide() || isManagerWrite();
      allow delete: if false;

      match /votes/{voteId} {
        allow read: if true;
        allow create, update: if validVoteWrite(voteId);
        allow delete: if false;
      }
    }

    match /secretMailboxPrivate98/{diaryId} {
      // The main app only queries the signed-in student's own uid.
      // The static manager page also reads this collection to show the writer name.
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.name is string
        && request.resource.data.nameKey is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1200
        && request.resource.data.kind == 'secret-diary';
      allow update: if isManagerWrite();
      allow delete: if ownsResource() || isManagerMarkedResource();
    }
  }
}
