rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isManagerWrite() {
      return request.resource.data.managerKey == 'class98-manager-2026'
        || request.resource.data.managerKey == 'lmt1102011';
    }

    function isManagerMarkedResource() {
      return resource.data.managerKey == 'class98-manager-2026'
        || resource.data.managerKey == 'lmt1102011';
    }

    function isManagerAuth() {
      return request.auth != null
        && request.auth.token.email == 'le-minh-tri@memorybook-of-class98.firebaseapp.com';
    }

    function ownsResource() {
      return request.auth != null
        && (
          resource.data.uid == request.auth.uid
          || (
            resource.data.nameKey is string
            && request.auth.token.email == resource.data.nameKey + '@memorybook-of-class98.firebaseapp.com'
          )
        );
    }

    function oldLikedBy() {
      return resource.data.keys().hasAny(['likedBy']) && resource.data.likedBy is list
        ? resource.data.likedBy
        : [];
    }

    function oldHeartedBy() {
      return resource.data.keys().hasAny(['heartedBy']) && resource.data.heartedBy is list
        ? resource.data.heartedBy
        : [];
    }

    function isPublicMemoryResource() {
      return !resource.data.keys().hasAny(['visibility'])
        || resource.data.visibility == 'public';
    }

    function canAccessPrivateMemoryResource() {
      return request.auth != null
        && (
          resource.data.uid == request.auth.uid
          || (
            resource.data.visibleToUids is list
            && request.auth.uid in resource.data.visibleToUids
          )
        );
    }

    function validMemoryBaseCreate() {
      return request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.imageUrl is string
        && request.resource.data.caption is string
        && request.resource.data.hashtags is list;
    }

    function ownsVideoChunkParent(memoryId) {
      return (
          request.resource.data.memoryCollection == 'memories98'
          && exists(/databases/$(database)/documents/memories98/$(memoryId))
          && get(/databases/$(database)/documents/memories98/$(memoryId)).data.uid == request.auth.uid
        )
        || (
          request.resource.data.memoryCollection == 'privateMemories98'
          && exists(/databases/$(database)/documents/privateMemories98/$(memoryId))
          && get(/databases/$(database)/documents/privateMemories98/$(memoryId)).data.uid == request.auth.uid
        );
    }

    function validOneLikeUpdate() {
      return request.auth != null
        && (isPublicMemoryResource() || canAccessPrivateMemoryResource())
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['reactions', 'likedBy', 'updatedAt'])
        && request.resource.data.reactions is int
        && request.resource.data.reactions == resource.data.reactions + 1
        && request.resource.data.likedBy is list
        && !(request.auth.uid in oldLikedBy())
        && request.auth.uid in request.resource.data.likedBy
        && request.resource.data.likedBy.size() == oldLikedBy().size() + 1
        && request.resource.data.likedBy.hasAll(oldLikedBy());
    }

    function isRememberReceiver() {
      return request.auth != null
        && resource.data.toNameKey is string
        && request.auth.token.email == resource.data.toNameKey + '@memorybook-of-class98.firebaseapp.com';
    }

    function validRememberViewedUpdate() {
      return isRememberReceiver()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedAt', 'updatedAt']);
    }

    function validRememberHeartUpdate() {
      return isRememberReceiver()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['heartedBy', 'updatedAt'])
        && request.resource.data.heartedBy is list
        && !(request.auth.uid in oldHeartedBy())
        && request.auth.uid in request.resource.data.heartedBy
        && request.resource.data.heartedBy.size() == oldHeartedBy().size() + 1
        && request.resource.data.heartedBy.hasAll(oldHeartedBy());
    }

    function validRememberReactionUpdate() {
      return isRememberReceiver()
        && resource.data.fromUid != request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reactionId',
          'reactionLabel',
          'reactedAt',
          'reactedBy',
          'updatedAt'
        ])
        && request.resource.data.reactionId in ['miss-you', 'thank-you', 'regret', 'good-luck']
        && request.resource.data.reactionLabel in ['Nhớ cậu', 'Cảm ơn', 'Tiếc nuối', 'Chúc may mắn']
        && request.resource.data.reactedBy == request.auth.uid
        && request.resource.data.reactedAt is timestamp;
    }

    function validVoteCategoryCreate() {
      return request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 180
        && request.resource.data.tone in ['pink', 'blue', 'cream', 'chalk']
        && request.resource.data.icon is string
        && request.resource.data.hidden == false;
    }

    function validVoteCategoryHide() {
      return request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden', 'hiddenAt', 'updatedAt'])
        && request.resource.data.hidden == true;
    }

    function validVoteWrite(voteId) {
      return request.auth != null
        && voteId == request.auth.uid
        && request.resource.data.voterUid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.targetUid is string
        && request.resource.data.targetName is string
        && request.resource.data.targetNameKey is string;
    }

    match /students98/{nameKey} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8';
      allow update: if (
        request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == resource.data.uid
      ) || isManagerWrite();
      allow delete: if false;
    }

    match /memories98/{memoryId} {
      allow read: if request.auth != null;
      allow create: if validMemoryBaseCreate()
        && (
          !request.resource.data.keys().hasAny(['visibility'])
          || request.resource.data.visibility == 'public'
        );
      allow update: if validOneLikeUpdate() || isManagerWrite();
      allow delete: if ownsResource() || isManagerMarkedResource();
    }

    match /privateMemories98/{memoryId} {
      allow read: if canAccessPrivateMemoryResource() || isManagerAuth();
      allow create: if validMemoryBaseCreate()
        && request.resource.data.visibility in ['private', 'tagged']
        && (
          request.resource.data.visibility == 'private'
          || (
            request.resource.data.visibleToUids is list
            && request.resource.data.visibleToUids.size() > 0
            && request.resource.data.visibleToUids.size() <= 30
          )
        );
      allow update: if validOneLikeUpdate() || isManagerWrite();
      allow delete: if ownsResource() || isManagerMarkedResource();
    }

    match /memoryVideoChunks98/{memoryId}/chunks/{chunkId} {
      allow read: if isManagerAuth()
        || (
          request.auth != null
          && (
            resource.data.visibility == 'public'
            || resource.data.uid == request.auth.uid
            || (
              resource.data.visibleToUids is list
              && request.auth.uid in resource.data.visibleToUids
            )
          )
        );
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.memoryId == memoryId
        && request.resource.data.memoryCollection in ['memories98', 'privateMemories98']
        && ownsVideoChunkParent(memoryId)
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 750000
        && request.resource.data.index is int
        && request.resource.data.total is int
        && request.resource.data.total > 0
        && request.resource.data.total <= 24
        && request.resource.data.visibility in ['public', 'private', 'tagged']
        && (
          request.resource.data.visibility != 'tagged'
          || (
            request.resource.data.visibleToUids is list
            && request.resource.data.visibleToUids.size() > 0
            && request.resource.data.visibleToUids.size() <= 30
          )
        );
      allow update: if isManagerWrite()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['managerKey', 'managerDeletedAt']);
      allow delete: if ownsResource() || isManagerMarkedResource();
    }

    match /memoryComments98/{commentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.memoryId is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 240;
      allow update: if false;
      allow delete: if ownsResource();
    }

    match /memoryDownloadLogs98/{logId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.memoryId is string
        && request.resource.data.memoryCollection in ['memories98', 'privateMemories98']
        && request.resource.data.memoryMediaType in ['image', 'video']
        && request.resource.data.name is string
        && request.resource.data.nameKey is string
        && request.resource.data.memoryOwnerName is string;
      allow update, delete: if false;
    }

    match /siteSettings98/{settingId} {
      allow read: if true;
      allow create, update: if settingId in ['memoryRecap', 'cinematicSlideshow']
        && isManagerWrite()
        && request.resource.data.enabled is bool;
      allow delete: if false;
    }

    match /guestbook98/{entryId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 160;
      allow update: if false;
      allow delete: if ownsResource();
    }

    match /secretMailbox98/{letterId} {
      allow read, create, update, delete: if false;
    }

    match /rememberNotes98/{noteId} {
      allow read: if true;
      allow create: if request.resource.data.className == '9/8'
        && request.resource.data.fromName is string
        && request.resource.data.fromNameKey is string
        && request.resource.data.toName is string
        && request.resource.data.toNameKey is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 420
        && request.resource.data.anonymous is bool
        && request.resource.data.kind == 'remember-note';
      allow update: if validRememberViewedUpdate() || validRememberHeartUpdate() || validRememberReactionUpdate();
      allow delete: if true;
    }

    match /voteCategories98/{categoryId} {
      allow read: if resource.data.hidden == false;
      allow create: if validVoteCategoryCreate();
      allow update: if validVoteCategoryHide() || isManagerWrite();
      allow delete: if false;

      match /votes/{voteId} {
        allow read: if true;
        allow create, update: if validVoteWrite(voteId);
        allow delete: if false;
      }
    }

    match /secretMailboxPrivate98/{diaryId} {
      // The main app only queries the signed-in student's own uid.
      // The static manager page also reads this collection to show the writer name.
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.className == '9/8'
        && request.resource.data.name is string
        && request.resource.data.nameKey is string
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 1200
        && request.resource.data.kind == 'secret-diary';
      allow update: if isManagerWrite();
      allow delete: if ownsResource();
    }
  }
}
